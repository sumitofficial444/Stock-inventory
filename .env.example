MONGO_URI=mongodb://127.0.0.1:27017/vedant-enterprises
JWT_SECRET=replace-with-a-long-random-secret
PORT=5051
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Required in production. Atlas supports transactions; standalone local MongoDB does not.
REQUIRE_TRANSACTIONS=false
# Register the shop owner, then set false to close public registration.
ALLOW_REGISTRATION=true
