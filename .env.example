MONGO_URI=mongodb://127.0.0.1:27017/vedant-enterprises
JWT_SECRET=replace-with-a-long-random-secret
PORT=5051
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Required in production. Atlas supports transactions; standalone local MongoDB does not.
REQUIRE_TRANSACTIONS=false
# Private single-shop application: public registration is always disabled in code.
ALLOW_REGISTRATION=false
ADMIN_EMAIL=admin@vedant.local
SETUP_ADMIN_EMAIL=admin@vedant.local
# Changing this value and restarting the server syncs the password and revokes old sessions.
SETUP_ADMIN_PASSWORD=
